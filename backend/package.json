    "test:prepare": "tsx scripts/prepareTestDatabase.ts",
    "test:check": "tsx scripts/prepareTestDatabase.ts --check",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit"
  },
  "keywords": [],
  "author": "",
