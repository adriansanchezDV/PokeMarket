    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
